{{ 'section-icon-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  style="--icon-size: {{ section.settings.icon_size }}px; --icon-wrapper-size: {{ section.settings.icon_wrapper_size }}px; --card-radius: {{ section.settings.card_radius }}px; --card-padding: {{ section.settings.card_padding }}px; --grid-gap: {{ section.settings.grid_gap }}px; --columns-mobile: {{ section.settings.columns_mobile }}; --columns-desktop: {{ section.settings.columns_desktop }}; --content-alignment: {{ section.settings.content_alignment }};"
>
  <div class="page-width">
    <div class="icon-with-text-section{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.title != blank or section.settings.text != blank -%}
        <div class="icon-with-text-section__header">
          {%- if section.settings.title != blank -%}
            <h2 class="icon-with-text-section__heading inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="icon-with-text-section__intro rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="icon-with-text-section__list icon-with-text-section__list--{{ section.settings.layout }}{% if section.settings.content_alignment == 'center' %} icon-with-text-section__list--center{% endif %}">
        {%- for block in section.blocks -%}
          <li class="icon-with-text-section__item{% if section.settings.content_alignment == 'center' %} icon-with-text-section__item--center{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="icon-with-text-section__icon-wrapper">
                <img
                  src="{{ block.settings.image | image_url: width: 200 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="icon-with-text-section__icon-wrapper">
                {% render 'icon-accordion', icon: block.settings.icon %}
              </div>
            {%- endif -%}

            <div class="icon-with-text-section__content">
              {%- if block.settings.heading != blank -%}
                <h3 class="icon-with-text-section__title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="icon-with-text-section__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon with text",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Why shoppers love us",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Add a short intro to explain the benefits of your offer.</p>",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ],
      "default": "horizontal",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "label": "Columns on mobile"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Grid gap"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Card padding"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Card radius"
    },
    {
      "type": "range",
      "id": "icon_wrapper_size",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Icon box size"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24,
      "label": "Icon size"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left",
      "label": "Content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "lock", "label": "Lock" },
            { "value": "chat_bubble", "label": "Chat bubble" }
          ],
          "default": "check_mark"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Fast delivery",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share a benefit or feature in a short sentence.</p>",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon with text",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
